#!/data/data/com.termux/files/usr/bin/bash
# ADB Auto-Connect Service for Termux (v3.0)
# Delegates discovery to `adb-control connect`: tries the saved port hint,
# scans otherwise. No ports are hardcoded here.
exec 2>&1

source ~/.adb_devices 2>/dev/null

INTERVAL="${ADB_RECONNECT_INTERVAL:-30}"
LOGFILE="${HOME}/.adb_connect.log"

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') $1" >> "$LOGFILE"
    tail -n 500 "$LOGFILE" > "$LOGFILE.tmp" 2>/dev/null && mv "$LOGFILE.tmp" "$LOGFILE"
}

log "SERVICE_START: ADB Auto-Connect v3.0"

while true; do
    while IFS='=' read -r name addr; do
        [[ "$name" =~ ^#.*$ ]] && continue
        [[ -z "$addr" ]] && continue
        ip="${addr%%:*}"
        if adb-control connect "$name" "$ip" >> "$LOGFILE" 2>&1; then
            log "CONNECTED: $name at $ip"
        else
            log "FAILED: $name at $ip (host unreachable or ADB disabled)"
        fi
    done < ~/.adb_devices 2>/dev/null

    sleep "$INTERVAL"
done
